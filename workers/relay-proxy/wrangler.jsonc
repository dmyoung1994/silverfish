{
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "name": "silverfish-relay-proxy",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-23",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "workers_dev": true,
  "preview_urls": false,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "assets": {
    "directory": "../../apps/desktop/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": [
      "/api/*",
      "/healthz"
    ]
  },
  "vars": {
    "ORIGIN_URL": "https://relay.example.com"
  }
}
